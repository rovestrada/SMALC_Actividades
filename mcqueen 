        "import cv2\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "gray_image = np.linspace(5, 100, 10000, dtype=np.uint8).reshape(100, 100)\n",
        "rgb_image = np.zeros((10, 100, 3), dtype=np. uint8)\n",
        "rgb_image[:, :, 0] = np.linspace(0, 255, 100).astype(np.uint8)\n",
        "rgb_image[:,:, 1] = np.linspace(255, 0, 100).astype(np. uint8)\n",
        "rgb_image[:, :, 2] = 128\n",
        "\n",
        "binary_image = np.zeros((100, 400), dtype=np.uint8)\n",
        "binary_image[::2,::2] = 255\n",
        "binary_image[1::2, 2::2] = 200\n",
        "\n",
        "\n",
        "fig, axs = plt.subplots(1, 3, figsize=(12, 4))\n",
        "axs[0].imshow(gray_image, cmap='gray')\n",
        "axs[0].set_title('Escala de Grises')\n",
        "axs[0].axis('off')\n",
        "axs[1].imshow(rgb_image)\n",
        "axs[1].set_title('Imagen RGB')\n",
        "axs[1].axis('off')\n",
        "axs [2].imshow(binary_image, cmap='gray')\n",
        "axs [2].set_title('Imagen Binaria')\n",
        "axs [2].axis('off')\n",
        "plt.show()"
      ]
